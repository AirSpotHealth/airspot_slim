/*
 * AirSpot Slim Rev3A, AH-013-0001-SCH, 25-Jun-2026.
 * nRF54L15-QFAA. Application overlay for NCS 3.2.1.
 * LED indices preserve the service contract: 0=blue, 1=red, 2=green.
 * Button P0.02 is active high through Q3; use its external bias.
 * Flash HOLD=P1.06, WP=P1.07. P1.13 belongs to Qi EN2.
 * Battery divider is 0.6 (R43=1M, R44=1M5); AIN1=P1.05.
 * Unused power-control pins retain schematic pull-down defaults.
 */

/* Remove DK-only devices and aliases before configuring the Slim. */
/ {
    model = "AirSpot Slim";
    /delete-node/ pwmleds;
    aliases {
        /delete-property/ led3;
        /delete-property/ pwm-led0;
        /delete-property/ sw1;
        /delete-property/ sw2;
        /delete-property/ sw3;
        /delete-property/ mcuboot-button0;
        /delete-property/ mcuboot-led0;
    };
};
/delete-node/ &led3;
/delete-node/ &button1;
/delete-node/ &button2;
/delete-node/ &button3;
/delete-node/ &mx25r64;
&pwm20 { status = "disabled"; };
&ieee802154 { status = "disabled"; };

&uicr {
	nfct-pins-as-gpios;
};

&nfct {
	status = "disabled";
};

&uart20 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart20_custom>;
	pinctrl-1 = <&uart20_custom_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {

	uart20_custom: uart20_custom {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>,
					<NRF_PSEL(UART_RX, 1, 3)>;
		};
	};

	uart20_custom_sleep: uart20_custom_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>,
					<NRF_PSEL(UART_RX, 1, 3)>;
			low-power-enable;
		};
	};
};

/ {
	leds: leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
			label = "LED 1";
		};
		led1: led_1 {
			gpios = <&gpio2 8 GPIO_ACTIVE_HIGH>;
			label = "LED 2";
		};
		led2: led_2 {
			gpios = <&gpio2 6 GPIO_ACTIVE_HIGH>;
			label = "LED 3";
		};
	};

	buttons {
		compatible = "gpio-keys";
		sw0: button_0 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "Button 0";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	chosen {
		zephyr,console = &uart20;
		zephyr,shell-uart = &uart20;
		/delete-property/ nordic,pm-ext-flash;
	};
};

&i2c30 {
	status = "okay";
	pinctrl-0 = <&i2c30_default>;
	pinctrl-1 = <&i2c30_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&pinctrl {

	i2c30_default: i2c30_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
			        <NRF_PSEL(TWIM_SCL, 0, 3)>;

		};
	};

	i2c30_sleep: i2c30_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
			        <NRF_PSEL(TWIM_SCL, 0, 3)>;
			low-power-enable;
		};
	};

	spi00_custom: spi00_custom {
		group2 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>;
			nordic,drive-mode = <NRF_DRIVE_S0S1>;
		};

		group3 {
			psels = <NRF_PSEL(SPIM_MOSI, 2, 2)>;
			nordic,drive-mode = <NRF_DRIVE_S0S1>;
		};

		group1 {
			psels = <NRF_PSEL(SPIM_MISO, 2, 4)>;
			nordic,drive-mode = <NRF_DRIVE_S0S1>;
		};
	};

	spi00_custom_sleep: spi00_custom_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
			        <NRF_PSEL(SPIM_MISO, 2, 4)>,
			        <NRF_PSEL(SPIM_MOSI, 2, 2)>;
			low-power-enable;
		};
	};

};

&spi00 {
	status = "okay";
	pinctrl-0 = <&spi00_custom>;
	pinctrl-1 = <&spi00_custom_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;

	at25xe161d: at25xe161d@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <2000000>;
		jedec-id = [ 1f 46 0c  ];
		size = <DT_SIZE_M(16)>;
	};
};

&gpio1 {
	flash_wp: flash_wp {
		gpio-hog;
		gpios = <7 GPIO_ACTIVE_HIGH>;
		output-high;
	};

	flash_hold: flash_hold {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

/ {

	power_pins: power_pins {
		compatible = "gpio-keys";

		batt_adc_en: batt_adc_en {
			gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
			label = "BATT_ADC_EN";
		};

		qi_chg_status: qi_chg_status {
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			label = "QI_CHG_STATUS";
		};
	};

	zephyr,user {
		io-channels = <&adc 1>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN1>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <8>;
	};
};

&wdt30 {
	status = "okay";
};

/ {
	aliases {
		watchdog0 = &wdt30;
	};
};


/* Internal MCUboot slots and NVS use the Nordic nRF54L15 partition map. */
