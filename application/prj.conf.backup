# AirSpot Slim - Minimal Baseline Configuration

# Enable BLE
CONFIG_BT=y
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_DEVICE_NAME="AirSpot Slim"
CONFIG_BT_MAX_CONN=1
CONFIG_BT_MAX_PAIRED=1

# Battery Service (BAS)
CONFIG_BT_BAS=y

# BLE Advertising and Scanning
CONFIG_BT_BROADCASTER=y
CONFIG_BT_OBSERVER=y
# Extended advertising is required for Mesh on NCS/SDC
CONFIG_BT_EXT_ADV=y
# Advertising intervals use defaults (can be configured via API if needed)

# =============================================================================
# Phase 4: NUS Service for App Communication
# =============================================================================
CONFIG_BT_GATT_DYNAMIC_DB=y
# Increase MTU for larger payloads
CONFIG_BT_L2CAP_TX_MTU=247
CONFIG_BT_BUF_ACL_RX_SIZE=251
CONFIG_BT_BUF_ACL_TX_SIZE=251

# Enable reboot for protocol reset command
CONFIG_REBOOT=y

# =============================================================================
# Phase 5: DFU via MCUboot + SMP over BLE
# =============================================================================
# NOTE: CONFIG_NCS_SAMPLE_MCUMGR_BT_OTA_DFU=y removed - causes crash during init
# All required MCUmgr configs are set manually below
CONFIG_BOOTLOADER_MCUBOOT=y
CONFIG_MCUMGR=y
CONFIG_MCUMGR_TRANSPORT_BT=y
CONFIG_MCUMGR_GRP_IMG=y
CONFIG_MCUMGR_GRP_OS=y
CONFIG_IMG_MANAGER=y
CONFIG_STREAM_FLASH=y
CONFIG_FLASH_MAP=y

# External flash is accessed via custom driver (spi_flash.c) for history
# Not using Zephyr SPI-NOR driver

# GPIO
CONFIG_GPIO=y

# Buttons (using GPIO directly, not DK library)
# CONFIG_DK_LIBRARY=y

# LEDs
CONFIG_LED=y

# Logging
CONFIG_LOG=y
CONFIG_LOG_MODE_IMMEDIATE=y
CONFIG_LOG_BACKEND_SHOW_COLOR=n
CONFIG_LOG_BACKEND_UART=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_PRINTK=y

# UART for logging
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_CONSOLE=y
CONFIG_UART_LINE_CTRL=n

# Power Management (basic)
# CONFIG_PM=y  # Has dependencies - enable later if needed
# CONFIG_PM_DEVICE=y

# Clock
CONFIG_CLOCK_CONTROL_NRF=y

# Timer
# CONFIG_NRF_RTC_TIMER=y  # Has dependencies - using default timer

# Enable watchdog
# CONFIG_WDT_NRFX=y  # Has dependencies - enable later if needed

# Memory
CONFIG_MAIN_STACK_SIZE=2048
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=2048

# Enable flash (internal)
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y

# Enable settings for storing configuration (BLE mode persistence)
CONFIG_SETTINGS=y
CONFIG_SETTINGS_NVS=y
CONFIG_NVS=y

# =============================================================================
# Phase 2 Hardware Drivers
# =============================================================================

# I2C for sensors (SHT40, STCC4, LPS22HH)
CONFIG_I2C=y

# SPI for external flash (AT25XE161D)
CONFIG_SPI=y

# External SPI NOR Flash (AT25XE161D for DFU secondary slot)
CONFIG_SPI_NOR=y
CONFIG_SPI_NOR_SFDP_RUNTIME=y
CONFIG_PM_EXTERNAL_FLASH_MCUBOOT_SECONDARY=y

# ADC for battery monitoring
# NOTE: ADC causes crash during early init - needs investigation
# Temporarily disabled until ADC initialization issue is resolved
# CONFIG_ADC=y


# =============================================================================
# Bluetooth Mesh Configuration (Dual-Mode: Peripheral + Mesh)
# =============================================================================
# The device supports both traditional BLE peripheral mode and Bluetooth Mesh.
# Mode can be switched at runtime via BLE command from the app.
# Default mode is Peripheral; Mesh is enabled when user provisions device.

# Core Mesh Support
CONFIG_BT_MESH=y

# Mesh features - minimal set
CONFIG_BT_MESH_RELAY=n
CONFIG_BT_MESH_LOW_POWER=n
CONFIG_BT_MESH_FRIEND=n

# Provisioning (ADV only to save space, no GATT proxy)
CONFIG_BT_MESH_PB_ADV=y
CONFIG_BT_MESH_PB_GATT=n
CONFIG_BT_MESH_GATT_PROXY=n

# Mesh settings persistence (uses BT_SETTINGS which is already enabled)
CONFIG_BT_SETTINGS=y

# Mesh network settings - minimal
CONFIG_BT_MESH_SUBNET_COUNT=1
CONFIG_BT_MESH_APP_KEY_COUNT=1
CONFIG_BT_MESH_MODEL_KEY_COUNT=1
CONFIG_BT_MESH_MODEL_GROUP_COUNT=1

# Trusted storage backend - disable (mesh uses BT_SETTINGS)
CONFIG_TRUSTED_STORAGE=n
CONFIG_MBEDTLS_PSA_CRYPTO_STORAGE_C=n

# =============================================================================
# Optimization
# =============================================================================
CONFIG_SIZE_OPTIMIZATIONS=y
CONFIG_DEBUG=n

# Additional size optimizations
CONFIG_PRINTK=y
CONFIG_CBPRINTF_NANO=y
CONFIG_BOOT_BANNER=y
CONFIG_THREAD_NAME=n
CONFIG_ERRNO=n

# Link-time optimization - temporarily disabled for logging debug
# CONFIG_LTO=y
# CONFIG_ISR_TABLES_LOCAL_DECLARATION=y

# Disable unused BLE features
CONFIG_BT_DEBUG_NONE=y
CONFIG_BT_ASSERT=n
CONFIG_BT_DATA_LEN_UPDATE=n
CONFIG_BT_PHY_UPDATE=n
CONFIG_BT_GATT_CACHING=n
CONFIG_BT_GAP_AUTO_UPDATE_CONN_PARAMS=n

# Reduce BLE buffers (minimal for single connection)
CONFIG_BT_BUF_CMD_TX_COUNT=3
CONFIG_BT_BUF_EVT_RX_COUNT=4
CONFIG_BT_BUF_EVT_DISCARDABLE_COUNT=2
CONFIG_BT_CONN_TX_MAX=3

# Reduce mesh buffers
CONFIG_BT_MESH_ADV_BUF_COUNT=4
CONFIG_BT_MESH_MSG_CACHE_SIZE=16
CONFIG_BT_MESH_CRPL=5

# Disable mesh features we don't need
# CONFIG_BT_MESH_DEBUG=n  # Removed: symbol undefined in this Zephyr version
CONFIG_BT_MESH_CFG_CLI=n
