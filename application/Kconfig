# AirSpot Slim Firmware Configuration

mainmenu "AirSpot Slim Configuration"

source "Kconfig.zephyr"

config AIRSPOT_CONTINUOUS_ALL_MODES
	bool "Continuous STCC4 acquisition in every reporting mode"
	default n
	depends on AIRSPOT_SENSOR_NATIVE_ONLY
	help
	  Measure CO2 and update temperature/humidity/pressure compensation at
	  1 Hz. Modes select only reporting cadence (Now, 3min, 1min, 5sec).
	  This increases power use; battery life requires hardware qualification.

# AirSpot-specific configuration
menu "AirSpot Configuration"

config AIRSPOT_SENSOR_NATIVE_ONLY
	bool "Rob evaluation: native ASC and FRC only"
	default n
	help
	  Bypass host offsets and use STCC4 FRC for app manual calibration.
	  Default legacy host policies to native ASC on; retain native off.

config AIRSPOT_STCC4_SINGLE_SHOT_SLEEP
	bool "Sleep STCC4 between single shots (qualification build)"
	default n
	help
	  Follow the datasheet wake/compensate/measure/read/sleep sequence.
	  Compare readings and current on real Slim hardware before enabling
	  in the production configuration. Continuous mode remains awake.

config AIRSPOT_STCC4_INTERNAL_ASC_EXPERIMENT
	bool "Legacy native ASC diagnostic overlay (deprecated)"
	default n
	help
	  Retained for compatibility with local diagnostic overlays. This must
	  not enable native ASC in user settings: new and legacy devices use
	  host calibration until the user explicitly enables native ASC. Saved
	  native preferences remain authoritative in every build.

config AIRSPOT_LOG_LEVEL
	int "AirSpot log level"
	default 3
	range 0 4
	help
	  Set log level for AirSpot modules:
	  0 = OFF
	  1 = ERROR
	  2 = WARNING
	  3 = INFO
	  4 = DEBUG

config AIRSPOT_BUTTON_LONG_PRESS_TIMEOUT_MS
	int "Button long press timeout (ms)"
	default 3000
	range 1000 10000
	help
	  Timeout in milliseconds for detecting long button press.

config AIRSPOT_STCC4_CONDITION_ON_BOOT
	bool "Condition STCC4 after long idle or missing timestamp"
	default y
	help
	  Missing clean-shutdown timestamp: condition once at startup.
	  Otherwise wait for app time and condition only if the pre-startup
	  idle gap exceeded 3 hours. Track longer single-shot idle periods
	  with uptime. Unexpected power loss invalidates the timestamp.

config AIRSPOT_BOOT_LED_SELFTEST
	bool "Run the LED self-test (color sweep) at boot"
	default n
	help
	  When enabled, led_driver_startup_sequence() runs at power-on: it
	  blinks each LED channel in turn and then all channels together, as a
	  visual confirmation that every LED works.

	  DISABLED by default so normal/production devices boot silently (the
	  UX rule is that the device never lights up without a reason). Enable
	  this only for factory-test firmware where the boot color sweep is a
	  wanted hardware check.

config AIRSPOT_POWER_OFF_ENABLED
	bool "Enable System OFF (shipping/power-off) mode"
	default n
	help
	  When enabled, the button power-off gesture and the BLE
	  "device sleep" command put the device into System OFF.

	  The production button is P0.02, which supports GPIO SENSE wake.
	  Enable after qualification of release-before-off and charger/hold wake.
	  Normal wake requires a five-second hold on Qi, followed by release.
	  Emergency wake: hold until the 15-second cue, release before 18 seconds,
	  regardless of Qi detection. Holding beyond the window cancels.

endmenu

config AIRSPOT_NATIVE_TEST_MODES
	bool "Native STCC4 single-shot/continuous battery comparison"
	depends on AIRSPOT_CONTINUOUS_ALL_MODES && AIRSPOT_SENSOR_NATIVE_ONLY
	default n
