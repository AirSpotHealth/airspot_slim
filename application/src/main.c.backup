#include <zephyr/kernel.h>
#include <zephyr/logging/log.h>
#include <zephyr/sys/printk.h>

#include <airspot/board.h>
#include <airspot/version.h>
#include <drivers/button_driver.h>
#include <drivers/led_driver.h>
#include <services/ble_mode_service.h>
#include <services/ble_service.h>
#include <services/data_log.h>
#include <services/protocol.h>
#include <services/sensor_manager.h>
#include <services/user_settings.h>

#if IS_ENABLED(CONFIG_BT_MESH)
#include <services/mesh_sensor.h>
#endif

LOG_MODULE_REGISTER(main, CONFIG_AIRSPOT_LOG_LEVEL);

/* Long press duration for factory reset (10 seconds) */
#define FACTORY_RESET_HOLD_MS 10000

/* Sensor measurement interval (5 seconds) */
#define SENSOR_INTERVAL_MS 5000

static int64_t button_press_start = 0;

/* Sensor data callback - called on each measurement */
static void sensor_data_handler(const sensor_data_t *data) {
  /* LED indication based on CO2 levels */
  if (data->valid && data->co2_ppm > 0) {
    if (data->co2_ppm < 800) {
      /* Good air quality - LED 0 green */
      led_driver_set(0, true);
      led_driver_set(1, false);
      led_driver_set(2, false);
    } else if (data->co2_ppm < 1500) {
      /* Moderate - LED 1 yellow */
      led_driver_set(0, false);
      led_driver_set(1, true);
      led_driver_set(2, false);
    } else {
      /* Poor air quality - LED 2 red */
      led_driver_set(0, false);
      led_driver_set(1, false);
      led_driver_set(2, true);
    }

    /* Store CO2 measurement to history (always, regardless of mode) */
    if (user_settings_is_time_set()) {
      uint32_t timestamp = user_settings_get_time_now();
      data_log_store_record(timestamp, data->co2_ppm, RECORD_TYPE_CO2);
    }

#if IS_ENABLED(CONFIG_BT_MESH)
    /* Publish sensor data over mesh if in mesh mode and provisioned */
    if (ble_mode_get_current() == BLE_MODE_MESH && mesh_sensor_is_ready()) {
      mesh_sensor_data_t mesh_data = {
          .co2_ppm = data->co2_ppm,
          .temperature_c100 = (int16_t)(data->temperature_c * 100),
          .humidity_c100 = (uint16_t)(data->humidity_rh * 100),
          .pressure_pa10 = (uint32_t)(data->pressure_hpa * 10),
          .valid = true,
      };
      mesh_sensor_update(&mesh_data);
      mesh_sensor_publish_now();
    }
#endif
  }

  /* Battery low warning */
  if (data->battery_critical) {
    LOG_WRN("BATTERY CRITICAL: %u%%", data->battery_percent);
    /* Store battery critical event */
    if (user_settings_is_time_set()) {
      uint32_t timestamp = user_settings_get_time_now();
      data_log_store_record(timestamp, data->battery_percent,
                            RECORD_TYPE_BATTERY_LOW);
    }
  } else if (data->battery_low) {
    LOG_WRN("Battery low: %u%%", data->battery_percent);
  }
}

/* Button event handler */
static void button_event_handler(button_event_t event) {
  switch (event) {
  case BUTTON_EVENT_PRESSED:
    LOG_INF("Button pressed");
    button_press_start = k_uptime_get();
    /* Trigger immediate sensor reading */
    sensor_manager_measure_now();
    break;

  case BUTTON_EVENT_RELEASED:
    LOG_DBG("Button released");
    /* Check if this was a long press for factory reset */
    if (button_press_start > 0) {
      int64_t hold_time = k_uptime_get() - button_press_start;
      if (hold_time >= FACTORY_RESET_HOLD_MS) {
        LOG_WRN("Factory reset triggered by 10s button hold");
        ble_mode_factory_reset();
      }
    }
    button_press_start = 0;
    break;

  case BUTTON_EVENT_LONG_PRESS:
    LOG_INF("Button long press");
    /* Turn off all LEDs on long press */
    led_driver_all_off();
    break;

  default:
    break;
  }
}

int main(void) {
  int ret;

  /* Early boot messages using printk - works before logging is ready */
  printk("\n\n");
  printk("========================================\n");
  printk("AirSpot Slim Firmware\n");
  printk("Version: %s\n", AIRSPOT_FIRMWARE_VERSION_STRING);
  printk("Board: nrf54l15dk/nrf54l05/cpuapp\n");
  printk("UART: TX=P1.02 (NFC1), RX=P1.03 (NFC2)\n");
  printk("LEDs: P1.06, P1.07, P1.08\n");
  printk("========================================\n");

  LOG_INF("========================================");
  LOG_INF("AirSpot Slim Firmware");
  LOG_INF("Version: %s", AIRSPOT_FIRMWARE_VERSION_STRING);
  LOG_INF("========================================");

  /* Initialize LED driver */
  ret = led_driver_init();
  if (ret) {
    LOG_ERR("LED driver init failed: %d", ret);
  } else {
    LOG_INF("LED driver initialized");
    led_driver_startup_sequence();
  }

  /* Initialize Button driver */
  ret = button_driver_init();
  if (ret) {
    LOG_ERR("Button driver init failed: %d", ret);
  } else {
    LOG_INF("Button driver initialized");
    button_driver_register_callback(button_event_handler);
  }

  /* Initialize Sensor Manager (I2C, SHT40, STCC4, LPS22HH, Battery, Qi) */
  ret = sensor_manager_init();
  if (ret) {
    LOG_ERR("Sensor manager init failed: %d", ret);
  } else {
    LOG_INF("Sensor manager initialized");
    sensor_manager_register_callback(sensor_data_handler);

    /* Start periodic measurements */
    sensor_manager_start(SENSOR_INTERVAL_MS);
  }

  /* Initialize user settings (NVS persistence) */
  ret = user_settings_init();
  if (ret) {
    LOG_ERR("User settings init failed: %d", ret);
  } else {
    LOG_INF("User settings: name='%s'", user_settings_get_device_name());
  }

  /* Initialize Data Log module (SPI flash storage) */
  ret = data_log_init();
  if (ret) {
    LOG_ERR("Data log init failed: %d", ret);
  } else {
    LOG_INF("Data log: %u records stored", data_log_get_count());
  }

  /* Initialize BLE service (underlying stack) */
  ret = ble_service_init();
  if (ret) {
    LOG_ERR("BLE service init failed: %d", ret);
  } else {
    LOG_INF("BLE service initialized");

    /* Initialize protocol handler (NUS for app communication) */
    ret = protocol_init();
    if (ret) {
      LOG_ERR("Protocol init failed: %d", ret);
    } else {
      LOG_INF("Protocol handler initialized");
    }

    /* Initialize BLE mode service (handles Peripheral/Mesh switching) */
    ret = ble_mode_init();
    if (ret) {
      LOG_ERR("BLE mode service init failed: %d", ret);
      /* Fall back to simple peripheral advertising */
      ble_service_start_advertising();
    } else {
      LOG_INF("BLE mode: %s",
              ble_mode_get_current() == BLE_MODE_MESH ? "MESH" : "PERIPHERAL");
    }
  }

  LOG_INF("System ready - sensor measurements every %d seconds",
          SENSOR_INTERVAL_MS / 1000);

  /* Main loop - minimal CPU usage */
  while (1) {
    /* Sleep for 100ms - allows other threads to run and responsive history
     * handling */
    k_sleep(K_MSEC(100));

    /* Process any pending history requests (read/erase) */
    protocol_process_history();

    /* Increment time base every ~10 iterations (1 second) */
    static uint8_t time_counter = 0;
    if (++time_counter >= 10) {
      time_counter = 0;
      if (user_settings_is_time_set()) {
        user_settings_inc_second();
      }
    }
  }

  return 0;
}
