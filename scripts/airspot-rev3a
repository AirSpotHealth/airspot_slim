#!/usr/bin/env bash
# Rev3A monolithic build/flash entry point. Sourced legacy helpers supply tools.
set -eo pipefail
rev3a_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$rev3a_script_dir/airspot"
rev3a_python="$NCS_TOOLCHAIN_DIR/bin/python3"

command_name="${1:-help}"
[[ $# -eq 0 ]] || shift
profile=debug
[[ "$command_name" != rtt ]] || profile=rtt
pristine=auto
for arg in "$@"; do
    case "$arg" in
        --debug) profile=debug ;;
        --release) profile=release ;;
        --rtt) profile=rtt ;;
        --clean|--pristine) pristine=always ;;
        *) echo "Unsupported Rev3A option: $arg (MCUboot/OTA are not enabled)" >&2; exit 1 ;;
    esac
done
build_dir="$AIRSPOT_PROJECT_DIR/build_rev3a_$profile"
artifact_tool="$rev3a_script_dir/rev3a_artifact.py"

case "$command_name" in
    build)
        conf=()
        case "$profile" in
            release) conf=(-DEXTRA_CONF_FILE=prj_release.conf) ;;
            rtt) conf=(-DEXTRA_CONF_FILE=prj_rtt.conf) ;;
            debug) conf=(-DEXTRA_CONF_FILE=) ;;
        esac
        mkdir -p "$build_dir"
        # A failed build must never leave the previous image marked flashable.
        rm -f "$build_dir/rev3a-artifact.json"
        west build -b nrf54l15dk/nrf54l15/cpuapp -d "$build_dir" \
            "$AIRSPOT_PROJECT_DIR" --no-sysbuild --pristine="$pristine" -- \
            -DUSE_CCACHE=0 "${conf[@]}"
        "$rev3a_python" "$artifact_tool" record "$build_dir"
        ;;
    check)
        "$rev3a_python" "$artifact_tool" verify "$build_dir"
        ;;
    flash)
        # Require the generated board/config and exact image hashes to agree.
        "$rev3a_python" "$artifact_tool" verify "$build_dir"
        probe=()
        if [[ -n "${AIRSPOT_JLINK_SERIAL:-}" ]]; then
            probe=(--dev-id "$AIRSPOT_JLINK_SERIAL")
        fi
        # The NCS runner uses nRF54L15_M33 and full Intel HEX addressing.
        # No recover/mass erase: preserve NVS during normal wired updates.
        west flash -d "$build_dir" --skip-rebuild --runner jlink -- \
            --reset --no-erase "${probe[@]}"
        ;;
    memory)
        "$rev3a_python" "$artifact_tool" verify "$build_dir"
        "$ZEPHYR_SDK_INSTALL_DIR/arm-zephyr-eabi/bin/arm-zephyr-eabi-size" \
            "$build_dir"/zephyr/airspot_slim_rev3a_*.elf
        ;;
    rtt)
        [[ "$profile" = rtt ]] || { echo "RTT requires the --rtt profile" >&2; exit 1; }
        "$rev3a_python" "$artifact_tool" verify "$build_dir"
        address=$("$ZEPHYR_SDK_INSTALL_DIR/arm-zephyr-eabi/bin/arm-zephyr-eabi-nm" \
            "$build_dir"/zephyr/airspot_slim_rev3a_*.elf | awk '$3 == "_SEGGER_RTT" {print $1}')
        [[ -n "$address" ]] || { echo "RTT control block not found" >&2; exit 1; }
        probe=()
        if [[ -n "${AIRSPOT_JLINK_SERIAL:-}" ]]; then
            probe=(-SelectEmuBySN "$AIRSPOT_JLINK_SERIAL")
        fi
        JLinkRTTLogger -Device nRF54L15_M33 -If SWD -Speed 1000 \
            -RTTAddress "0x$address" -RTTChannel 0 "${probe[@]}" "$build_dir/rtt.log"
        ;;
    clean)
        rm -rf "$build_dir"
        ;;
    help|--help|-h)
        echo "Rev3A: airspot {build|check|flash|memory|clean} [--debug|--release|--rtt] [--clean]"
        echo "Each profile has its own build directory. Flash requires a successful checked build."
        echo "RTT capture: airspot logs rtt (after flashing the RTT profile)."
        ;;
    *) echo "Unknown Rev3A command: $command_name" >&2; exit 1 ;;
esac
