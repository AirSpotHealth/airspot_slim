#!/bin/bash
# AirSpot Slim Development Tool
# Source this file: source scripts/airspot
# Then use: airspot build, airspot flash, airspot logs, etc.

# Configuration
if [[ -n "${ZSH_VERSION}" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
else
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
export AIRSPOT_WORKSPACE="${AIRSPOT_WORKSPACE:-$(dirname "$SCRIPT_DIR")}"
export AIRSPOT_PROJECT_DIR="$AIRSPOT_WORKSPACE/application"
export AIRSPOT_BUILD_DIR="$AIRSPOT_PROJECT_DIR/build"
export AIRSPOT_BOARD="nrf54l15dk/nrf54l05/cpuapp"

# NCS Toolchain Configuration
NCS_TOOLCHAIN_DIR="/opt/nordic/ncs/toolchains/322ac893fe"
export ZEPHYR_TOOLCHAIN_VARIANT=zephyr
export ZEPHYR_SDK_INSTALL_DIR="$NCS_TOOLCHAIN_DIR/opt/zephyr-sdk"
export ZEPHYR_BASE="$AIRSPOT_WORKSPACE/external/zephyr"

# Source Zephyr environment (provides west build command)
if [ -f "$ZEPHYR_BASE/zephyr-env.sh" ]; then
    source "$ZEPHYR_BASE/zephyr-env.sh" 2>/dev/null
fi

# Add NCS toolchain to PATH but keep system git (NCS git is broken on macOS)
# System git must come BEFORE NCS toolchain paths
NCS_PATH="$NCS_TOOLCHAIN_DIR/Cellar/cmake/3.21.0/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/usr/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/usr/local/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/opt/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/opt/nanopb/generator-bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/nrfutil/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/opt/zephyr-sdk/arm-zephyr-eabi/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/opt/zephyr-sdk/riscv64-zephyr-elf/bin"

if [[ ":$PATH:" != *":$NCS_TOOLCHAIN_DIR/Cellar/cmake:"* ]]; then
    # Put system paths first so system git is used (NCS git missing remote-https)
    export PATH="/usr/bin:/opt/homebrew/bin:$NCS_PATH:$PATH"
fi

# Colors
_RED='\033[0;31m'
_GREEN='\033[0;32m'
_YELLOW='\033[1;33m'
_BLUE='\033[0;34m'
_CYAN='\033[0;36m'
_NC='\033[0m'

_print_success() { echo -e "${_GREEN}✓${_NC} $1"; }
_print_error() { echo -e "${_RED}✗${_NC} $1"; }
_print_info() { echo -e "${_BLUE}ℹ${_NC} $1"; }
_print_warning() { echo -e "${_YELLOW}⚠${_NC} $1"; }

# Extract version from version.h
_get_firmware_version() {
    local version_file="$AIRSPOT_PROJECT_DIR/include/airspot/version.h"
    if [ -f "$version_file" ]; then
        local major minor patch
        major=$(grep 'AIRSPOT_FIRMWARE_VERSION_MAJOR' "$version_file" | grep -o '[0-9]*')
        minor=$(grep 'AIRSPOT_FIRMWARE_VERSION_MINOR' "$version_file" | grep -o '[0-9]*')
        patch=$(grep 'AIRSPOT_FIRMWARE_VERSION_PATCH' "$version_file" | grep -o '[0-9]*')
        echo "${major}.${minor}.${patch}"
    else
        echo "0.0.0"
    fi
}

# Get kernel bin name based on version
_get_bin_name() {
    local version="$(_get_firmware_version)"
    echo "airspot_slim_v${version}"
}

_find_jlinkexe() {
    if command -v JLinkExe &> /dev/null; then
        command -v JLinkExe
        return 0
    fi
    local jlink
    jlink=$(ls -1 /Applications/SEGGER/JLink_*/JLinkExe 2>/dev/null | sort | tail -n 1)
    if [ -n "$jlink" ]; then
        echo "$jlink"
        return 0
    fi
    return 1
}

# Main airspot command function
airspot() {
    local cmd=$1
    [[ $# -gt 0 ]] && shift
    
    case "$cmd" in
        build)
            airspot_build "$@"
            ;;
        flash)
            airspot_flash "$@"
            ;;
        ports)
            airspot_ports
            ;;
        logs)
            airspot_logs "$@"
            ;;
        monitor)
            airspot_logs "$@"
            ;;
        erase)
            airspot_erase "$@"
            ;;
        reset)
            airspot_reset "$@"
            ;;
        clean)
            airspot_clean "$@"
            ;;
        info)
            airspot_info "$@"
            ;;
        memory)
            airspot_memory "$@"
            ;;
        version)
            airspot_version
            ;;
        menu)
            airspot_menu
            ;;
        bf)
            airspot_build && airspot_flash
            ;;
        bfl)
            airspot_build && airspot_flash && airspot_logs
            ;;
        help|--help|-h)
            airspot_help
            ;;
        *)
            if [ -z "$cmd" ]; then
                airspot_help
            else
                _print_error "Unknown command: $cmd"
                airspot_help
                return 1
            fi
            ;;
    esac
}

# Update prj.conf with current version
_update_prj_conf_version() {
    local version="$(_get_firmware_version)"
    local prj_conf="$AIRSPOT_PROJECT_DIR/prj.conf"
    local bin_name="airspot_slim_v${version}"
    
    # Check if CONFIG_KERNEL_BIN_NAME exists and update it
    if grep -q "CONFIG_KERNEL_BIN_NAME" "$prj_conf"; then
        # Update existing line
        sed -i.bak "s/CONFIG_KERNEL_BIN_NAME=.*/CONFIG_KERNEL_BIN_NAME=\"${bin_name}\"/" "$prj_conf"
        rm -f "${prj_conf}.bak"
    fi
}

# Build command
airspot_build() {
    local version="$(_get_firmware_version)"
    local bin_base_name="airspot_slim_v${version}"
    local timestamp=$(date +"%Y%m%d_%H%M%S")
    local do_dfu=false
    local pristine=""
    
    _print_info "AirSpot Slim Firmware v${version}"
    cd "$AIRSPOT_PROJECT_DIR"
    
    # Ensure system git is used
    export PATH="/usr/bin:/opt/homebrew/bin:$PATH"
    
    # Update prj.conf with current version
    _update_prj_conf_version
    
    # Parse arguments
    for arg in "$@"; do
        case "$arg" in
            --clean|--pristine)
                pristine="--pristine"
                ;;
            --dfu)
                do_dfu=true
                ;;
        esac
    done
    
    if [ "$do_dfu" = true ]; then
        _print_info "Building with DFU support (Sysbuild + MCUboot)..."
        
        # Build with sysbuild enabled (creates MCUboot + signed app)
        west build -b "$AIRSPOT_BOARD" --sysbuild $pristine
        
        if [ $? -ne 0 ]; then
            _print_error "Sysbuild failed!"
            return 1
        fi
        
        _print_success "Build complete (Sysbuild)!"
        
        # --- Artifact Collection for DFU ---
        local sysbuild_dir="$AIRSPOT_BUILD_DIR"
        local app_update_bin=""
        
        # Locate signed binary
        # Logic: sysbuild puts app in 'application' subdir
        # Name: usually matches CONFIG_KERNEL_BIN_NAME + .signed.bin
        
        # 1. Try versioned name in application/zephyr (Most likely)
        if [ -f "$sysbuild_dir/application/zephyr/${bin_base_name}.signed.bin" ]; then
            app_update_bin="$sysbuild_dir/application/zephyr/${bin_base_name}.signed.bin"
        
        # 2. Try generic zephyr.signed.bin in application/zephyr
        elif [ -f "$sysbuild_dir/application/zephyr/zephyr.signed.bin" ]; then
            app_update_bin="$sysbuild_dir/application/zephyr/zephyr.signed.bin"
            
        # 3. Legacy locations
        elif [ -f "$sysbuild_dir/app/zephyr/zephyr.signed.bin" ]; then
            app_update_bin="$sysbuild_dir/app/zephyr/zephyr.signed.bin"
        elif [ -f "$sysbuild_dir/zephyr/zephyr.signed.bin" ]; then
            app_update_bin="$sysbuild_dir/zephyr/zephyr.signed.bin"
        fi
        
        if [ -z "$app_update_bin" ]; then
           _print_error "Could not find signed binary for DFU!"
           return 1
        fi

        # Generate DFU Zip
        # --- Release Organization (DFU) ---
        # Structure: releases/vX.Y.Z/
        local release_version_dir="$AIRSPOT_WORKSPACE/releases/v${version}"
        mkdir -p "$release_version_dir"

        _print_info "Generating DFU package..."
        local dfu_zip_name="${bin_base_name}_${timestamp}_dfu.zip"
        local dfu_zip_path="$release_version_dir/$dfu_zip_name"
        
        # Check for keys (User provided or Zephyr default)
        local key_file=""
        if [ -f "$AIRSPOT_PROJECT_DIR/keys/airspot-signing-key-ecdsa.pem" ]; then
            key_file="$AIRSPOT_PROJECT_DIR/keys/airspot-signing-key-ecdsa.pem"
        elif [ -f "$AIRSPOT_PROJECT_DIR/keys/airspot-signing-key.pem" ]; then
            key_file="$AIRSPOT_PROJECT_DIR/keys/airspot-signing-key.pem"
        elif [ -f "$AIRSPOT_PROJECT_DIR/keys/root-ec-p256.pem" ]; then
            key_file="$AIRSPOT_PROJECT_DIR/keys/root-ec-p256.pem"
        fi
        
        local generated_nrfutil=false
        
        # Prefer nrfutil if available AND key exists
        if command -v nrfutil &> /dev/null && [ -f "$key_file" ]; then
             _print_info "Using nrfutil to generate package..."
             nrfutil pkg generate \
                --application "$app_update_bin" \
                --application-version-string "$version" \
                --hw-version 52 \
                --sd-req 0x00 \
                --key-file "$key_file" \
                "$dfu_zip_path"
                
             if [ $? -eq 0 ]; then
                 generated_nrfutil=true
             else
                 _print_warning "nrfutil command failed. Falling back to MCUmgr zip..."
             fi
        fi
        
        if [ "$generated_nrfutil" = false ]; then
            if [ -f "$key_file" ]; then
                # Already sounded warning above if nrfutil failed
                if ! command -v nrfutil &> /dev/null; then
                     _print_warning "nrfutil not found, using MCUmgr zip (Zephyr default)..."
                fi
            else
                _print_warning "Signing key not found, using MCUmgr zip (Zephyr default)..."
            fi
            
            # MCUmgr manual zip fallback
            _print_info "Creating MCUmgr zip package..."
            local manifest_file="$release_version_dir/manifest.json"
            cat > "$manifest_file" << EOF
{
    "format-version": 1,
    "time": $(date +%s),
    "files": [
        {
            "type": "application",
            "board": "airspot_slim",
            "soc": "nrf54l05",
            "version": "$version",
            "file": "zephyr.signed.bin"
        }
    ]
}
EOF
            cp "$app_update_bin" "$release_version_dir/zephyr.signed.bin"
            
            _print_info "Zipping artifacts..."
            (cd "$release_version_dir" && zip -j "$dfu_zip_path" manifest.json zephyr.signed.bin)
            
            if [ $? -eq 0 ]; then
                _print_success "Zip created successfully."
            else
                _print_error "Zip command failed."
            fi
            
            rm -f "$release_version_dir/manifest.json" "$release_version_dir/zephyr.signed.bin"
        fi
        
        if [ ! -f "$dfu_zip_path" ]; then
             _print_error "Failed to create DFU package"
             return 1
        fi
        _print_success "DFU Package created: releases/v${version}/$dfu_zip_name"
        
        # Copy Merged Hex (if exists)
        local merged_hex_name="${bin_base_name}_${timestamp}_merged.hex"
        if [ -f "$sysbuild_dir/zephyr/merged.hex" ]; then
             cp "$sysbuild_dir/zephyr/merged.hex" "$release_version_dir/$merged_hex_name"
        elif [ -f "$sysbuild_dir/merged.hex" ]; then
             cp "$sysbuild_dir/merged.hex" "$release_version_dir/$merged_hex_name"
        fi
        
        # Copy Signed Bin
        local signed_bin_name="${bin_base_name}_${timestamp}_signed.bin"
        cp "$app_update_bin" "$release_version_dir/$signed_bin_name"
        
        _print_success "Release artifact stored: releases/v${version}/"

    else
        _print_info "Building Standard application (no DFU)..."
        
        west build -b "$AIRSPOT_BOARD" --no-sysbuild $pristine
        
        if [ $? -ne 0 ]; then
            _print_error "Build failed!"
            return 1
        fi
        _print_success "Build complete!"
        
        airspot_memory
        
        # --- Release Organization (Standard) ---
        # Structure: releases/vX.Y.Z/
        local release_version_dir="$AIRSPOT_WORKSPACE/releases/v${version}"
        mkdir -p "$release_version_dir"
        
        local hex_name="${bin_base_name}_${timestamp}.hex"
        local bin_name="${bin_base_name}_${timestamp}.bin"
        local elf_name="${bin_base_name}_${timestamp}.elf"
        
        cp "$AIRSPOT_BUILD_DIR/zephyr/${bin_base_name}.hex" "$release_version_dir/$hex_name" 2>/dev/null
        cp "$AIRSPOT_BUILD_DIR/zephyr/${bin_base_name}.bin" "$release_version_dir/$bin_name" 2>/dev/null
        cp "$AIRSPOT_BUILD_DIR/zephyr/${bin_base_name}.elf" "$release_version_dir/$elf_name" 2>/dev/null
        
        # Copy to builds/ (latest convenience)
        local builds_dir="$AIRSPOT_WORKSPACE/builds"
        mkdir -p "$builds_dir"
        cp "$AIRSPOT_BUILD_DIR/zephyr/${bin_base_name}.hex" "$builds_dir/${bin_base_name}.hex" 2>/dev/null

        if [ -f "$release_version_dir/$hex_name" ]; then
            _print_success "Release artifact stored: releases/v${version}/"
        fi
    fi
}

# Flash command
airspot_flash() {
    # Check for hex file in various locations (versioned name first, then fallbacks)
    local hex_file=""
    local bin_name="$(_get_bin_name)"
    
    if [ -f "$AIRSPOT_BUILD_DIR/merged.hex" ]; then
        hex_file="$AIRSPOT_BUILD_DIR/merged.hex"
    elif [ -f "$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.hex" ]; then
        hex_file="$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.hex"
    elif [ -f "$AIRSPOT_BUILD_DIR/application/zephyr/zephyr.hex" ]; then
        hex_file="$AIRSPOT_BUILD_DIR/application/zephyr/zephyr.hex"
    elif [ -f "$AIRSPOT_BUILD_DIR/zephyr/zephyr.hex" ]; then
        hex_file="$AIRSPOT_BUILD_DIR/zephyr/zephyr.hex"
    fi
    
    if [ -z "$hex_file" ]; then
        _print_error "No build found. Run 'airspot build' first."
        return 1
    fi
    
    cd "$AIRSPOT_PROJECT_DIR"
    _print_info "Flashing $hex_file..."

    if command -v nrfjprog &> /dev/null; then
        nrfjprog --program "$hex_file" --sectorerase --verify --reset -f NRF54L
    else
        local jlinkexe
        jlinkexe="$(_find_jlinkexe)"
        if [ -n "$jlinkexe" ]; then
            _print_warning "nrfjprog not found. Falling back to JLinkExe."
        cat > /tmp/jlink_flash.jlink <<EOF
device NRF54L05_XXAA
si SWD
speed 4000
r
loadfile $hex_file
r
q
EOF
            "$jlinkexe" -CommandFile /tmp/jlink_flash.jlink
        rm -f /tmp/jlink_flash.jlink
        else
            _print_error "No flash tool found (nrfjprog or JLinkExe)."
            _print_info "Install Nordic nRF Command Line Tools or SEGGER J-Link."
            return 1
        fi
    fi

    if [ $? -eq 0 ]; then
        _print_success "Flash complete!"
        sleep 0.5
    else
        _print_error "Flash failed!"
        return 1
    fi
}

_airspot_list_uart_ports() {
    ls /dev/cu.usbmodem* /dev/cu.usbserial* /dev/tty.usbmodem* /dev/tty.usbserial* 2>/dev/null
}

airspot_ports() {
    echo ""
    _print_info "Detected UART ports"
    echo "══════════════════════════════════════"
    local ports
    ports="$(_airspot_list_uart_ports)"
    if [ -z "$ports" ]; then
        _print_warning "No UART ports found."
        return 1
    fi
    echo "$ports"
    echo ""
}

_airspot_logs_uart() {
    local port="${1}"
    local baud="${2:-115200}"

    if [ -z "$port" ]; then
        local ports
        ports="$(_airspot_list_uart_ports)"
        if [ -z "$ports" ]; then
            port=""
        else
            local count
            count=$(echo "$ports" | wc -l | tr -d ' ')
            if [ "$count" -eq 1 ]; then
                port="$ports"
            else
                _print_info "Multiple UART ports detected:"
                local i=1
                while IFS= read -r line; do
                    echo "  $i) $line"
                    i=$((i + 1))
                done <<< "$ports"
                echo -n "Select port [1-$((i - 1))] (default 1): "
                read selection
                if [ -z "$selection" ]; then
                    selection=1
                fi
                port=$(echo "$ports" | sed -n "${selection}p")
            fi
        fi
    fi

    if [ -z "$port" ]; then
        _print_error "No UART device found. Pass port explicitly."
        airspot_ports
        _print_info "Example: airspot logs uart /dev/tty.usbmodemXXXX 115200"
        return 1
    fi

    _print_info "UART Monitor (serial)"
    _print_info "Port: $port"
    _print_info "Baud: $baud"
    _print_warning "Press Ctrl+C to exit"
    echo ""

    if command -v screen &> /dev/null; then
        screen "$port" "$baud"
    elif command -v picocom &> /dev/null; then
        picocom -b "$baud" "$port"
    elif command -v minicom &> /dev/null; then
        minicom -b "$baud" -D "$port"
    else
        _print_error "No serial monitor found (screen/picocom/minicom)."
        return 1
    fi
}

_airspot_logs_rtt() {
    _print_info "RTT Monitor (SEGGER Real-Time Transfer over SWD)"
    _print_warning "Press Ctrl+C to exit"
    echo ""

    _print_info "Resetting device..."
    nrfjprog --reset -f NRF54L 2>/dev/null
    sleep 0.5

    if command -v JLinkRTTLogger &> /dev/null; then
        _print_info "Starting RTT logger..."
        JLinkRTTLogger -Device NRF54L05_XXAA -If SWD -Speed 4000 -RTTChannel 0
    elif command -v JLinkExe &> /dev/null; then
        _print_info "Using JLinkExe for RTT..."
        _print_warning "Type 'exit' to quit JLink"
        echo ""
        cat > /tmp/jlink_rtt.jlink <<EOF
connect
NRF54L05_XXAA
SWD
4000
exit
EOF
        JLinkExe -CommandFile /tmp/jlink_rtt.jlink
        rm -f /tmp/jlink_rtt.jlink
    else
        _print_error "JLink tools not found. Please install SEGGER J-Link tools."
        _print_info "Download from: https://www.segger.com/downloads/jlink/"
        return 1
    fi
}

# Logs/Monitor command (default UART; optional RTT)
airspot_logs() {
    local mode="${1:-uart}"
    [[ $# -gt 0 ]] && shift

    case "$mode" in
        uart)
            _airspot_logs_uart "$@"
            ;;
        rtt)
            _airspot_logs_rtt "$@"
            ;;
        *)
            _print_error "Unknown logs mode: $mode (use: uart|rtt)"
            return 1
            ;;
    esac
}

# Erase command
airspot_erase() {
    local confirm="${1}"
    
    if [ "$confirm" != "-y" ] && [ "$confirm" != "--yes" ]; then
        _print_warning "This will erase the entire chip!"
        echo -n "Are you sure? (y/n): "
        read REPLY
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            _print_info "Erase cancelled."
            return 0
        fi
    fi
    
    _print_info "Erasing chip..."
    nrfjprog --eraseall -f NRF54L
    
    if [ $? -eq 0 ]; then
        _print_success "Chip erased!"
    else
        _print_error "Erase failed!"
        return 1
    fi
}

# Reset command
airspot_reset() {
    _print_info "Resetting device..."
    nrfjprog --reset -f NRF54L
    _print_success "Device reset!"
}

# Clean command
airspot_clean() {
    _print_info "Cleaning build directories..."
    cd "$AIRSPOT_PROJECT_DIR"
    rm -rf build build_*
    _print_success "Build directories cleaned!"
}

# Info command
airspot_info() {
    local version="$(_get_firmware_version)"
    local bin_name="$(_get_bin_name)"
    
    echo ""
    _print_info "Device Information"
    echo "══════════════════════════════════════"
    echo ""
    echo "Firmware: AirSpot Slim v${version}"
    echo "Board:    $AIRSPOT_BOARD"
    echo ""
    echo "Connected devices:"
    nrfjprog --ids 2>/dev/null || echo "  (nrfjprog not available)"
    echo ""
    
    local elf_file=""
    if [ -f "$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.elf" ]; then
        elf_file="$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.elf"
    elif [ -f "$AIRSPOT_BUILD_DIR/application/zephyr/zephyr.elf" ]; then
        elf_file="$AIRSPOT_BUILD_DIR/application/zephyr/zephyr.elf"
    elif [ -f "$AIRSPOT_BUILD_DIR/zephyr/zephyr.elf" ]; then
        elf_file="$AIRSPOT_BUILD_DIR/zephyr/zephyr.elf"
    fi
    
    if [ -n "$elf_file" ]; then
        airspot_memory
    fi
}

# Memory command
airspot_memory() {
    local bin_name="$(_get_bin_name)"
    local elf_file=""
    
    if [ -f "$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.elf" ]; then
        elf_file="$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.elf"
    elif [ -f "$AIRSPOT_BUILD_DIR/application/zephyr/zephyr.elf" ]; then
        elf_file="$AIRSPOT_BUILD_DIR/application/zephyr/zephyr.elf"
    elif [ -f "$AIRSPOT_BUILD_DIR/zephyr/zephyr.elf" ]; then
        elf_file="$AIRSPOT_BUILD_DIR/zephyr/zephyr.elf"
    fi
    
    if [ -z "$elf_file" ]; then
        _print_error "No build found."
        return 1
    fi
    
    echo ""
    _print_info "Memory Usage"
    echo "══════════════════════════════════════"
    "$ZEPHYR_SDK_INSTALL_DIR/arm-zephyr-eabi/bin/arm-zephyr-eabi-size" "$elf_file"
    echo ""
}

# Version command
airspot_version() {
    local version="$(_get_firmware_version)"
    echo ""
    _print_info "AirSpot Slim Firmware"
    echo "══════════════════════════════════════"
    echo "Version: v${version}"
    echo "Build name: $(_get_bin_name)"
    echo ""
    
    # Show latest release if exists
    local releases_dir="$AIRSPOT_WORKSPACE/releases"
    if [ -d "$releases_dir" ]; then
        local latest=$(ls -1t "$releases_dir"/*.hex 2>/dev/null | head -1)
        if [ -n "$latest" ]; then
            echo "Latest release: $(basename "$latest")"
        fi
    fi
    echo ""
}

# Interactive menu
airspot_menu() {
    while true; do
        echo ""
        echo -e "${_CYAN}╔══════════════════════════════════════════════════╗${_NC}"
        echo -e "${_CYAN}║${_NC}  ${_GREEN}AirSpot Slim Development Tool${_NC}                  ${_CYAN}║${_NC}"
        echo -e "${_CYAN}╚══════════════════════════════════════════════════╝${_NC}"
        echo ""
        echo -e "${_GREEN}BUILD & FLASH:${_NC}"
        echo "  1) Build"
        echo "  2) Flash"
        echo "  3) Build + Flash"
        echo "  4) Build + Flash + Logs"
        echo ""
        echo -e "${_GREEN}MONITORING:${_NC}"
        echo "  5) Logs/Monitor (UART default)"
        echo ""
        echo -e "${_GREEN}DEVICE:${_NC}"
        echo "  6) Reset"
        echo "  7) Erase chip"
        echo "  8) Device info"
        echo "  9) Clean build"
        echo ""
        echo -e "${_RED} 0) Exit${_NC}"
        echo ""
        echo -n "Select option: "
        read choice
        
        case $choice in
            1) airspot build ;;
            2) airspot flash ;;
            3) airspot bf ;;
            4) airspot bfl ;;
            5) airspot logs ;;
            6) airspot reset ;;
            7) airspot erase ;;
            8) airspot info ;;
            9) airspot clean ;;
            0) break ;;
            *) _print_error "Invalid option" ;;
        esac
        
        if [ "$choice" != "0" ]; then
            echo ""
            echo -n "Press Enter to continue..."
            read
        fi
    done
}

# Help command
airspot_help() {
    local version="$(_get_firmware_version)"
    cat << EOF

AirSpot Slim Development Tool (v${version})
═════════════════════════════════════════════════════════

COMMANDS:
  airspot build [opts]      - Build firmware
    Options:
      --clean               - Clean build
      --dfu                 - OTA Build (Sysbuild + MCUboot + DFU Zip)
  
  airspot flash             - Flash firmware to device
  airspot logs [uart|rtt]   - View logs (UART default)
  airspot monitor           - Alias for logs
  airspot erase [-y]        - Erase entire chip
  airspot reset             - Reset device
  airspot clean             - Clean build directory
  airspot info              - Show device information
  airspot memory            - Show memory usage
  airspot version           - Show firmware version
  airspot menu              - Interactive menu
  airspot help              - Show this help

SHORTCUTS:
  airspot bf                - Build + Flash
  airspot bfl               - Build + Flash + Logs

RELEASE ARTIFACTS:
  Releases are organized by version in: releases/v${version}/
  
  Standard Build:
    - airspot_slim_v${version}_TIMESTAMP.hex
    - airspot_slim_v${version}_TIMESTAMP.bin
    
  DFU Build (--dfu):
    - airspot_slim_v${version}_TIMESTAMP_dfu.zip   (OTA Package)
    - airspot_slim_v${version}_TIMESTAMP_signed.bin
    - airspot_slim_v${version}_TIMESTAMP_merged.hex (Full Image)

EXAMPLES:
  airspot build             # Standard build
  airspot build --dfu       # Build with DFU support
  airspot build --clean     # Clean rebuild
  airspot flash             # Flash to device
  airspot logs              # View UART logs
  airspot bfl               # Build, flash, and view logs

EOF
}

# Only show menu if script is executed directly (not sourced)
if [[ -z "${AIRSPOT_NO_AUTO_MENU}" ]]; then
    if [[ -n "${ZSH_VERSION}" ]]; then
        if [[ "${(%):-%x}" == "${0}" ]]; then
            airspot_menu
        fi
    elif [[ -n "${BASH_VERSION}" ]]; then
        if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
            airspot_menu
        fi
    fi
fi
