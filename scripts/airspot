#!/bin/bash
# AirSpot Slim Development Tool
# Source this file: source scripts/airspot
# Then use: airspot build, airspot flash, airspot logs, etc.

# Configuration
if [[ -n "${ZSH_VERSION}" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
else
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

# Always anchor workspace to this script location so stale shell env values
# cannot redirect builds to an old checkout path.
resolved_workspace="$(cd "$(dirname "$SCRIPT_DIR")" && pwd -P)"
if [[ -n "${AIRSPOT_WORKSPACE}" && "${AIRSPOT_WORKSPACE}" != "${resolved_workspace}" ]]; then
    echo "Warning: ignoring stale AIRSPOT_WORKSPACE=${AIRSPOT_WORKSPACE}" >&2
fi
export AIRSPOT_WORKSPACE="${resolved_workspace}"
export AIRSPOT_PROJECT_DIR="$AIRSPOT_WORKSPACE/application"
export AIRSPOT_HARDWARE="${AIRSPOT_HARDWARE:-rev3a}"
case "$AIRSPOT_HARDWARE" in
    rev3a)
        export AIRSPOT_BUILD_DIR="$AIRSPOT_PROJECT_DIR/build_rev3a_debug"
        export AIRSPOT_BOARD="nrf54l15dk/nrf54l15/cpuapp"
        export AIRSPOT_JLINK_DEVICE="nRF54L15_M33"
        ;;
    legacy)
        export AIRSPOT_BUILD_DIR="$AIRSPOT_PROJECT_DIR/build"
        export AIRSPOT_BOARD="nrf54l15dk/nrf54l05/cpuapp"
        export AIRSPOT_JLINK_DEVICE="nRF54L05_M33"
        ;;
    *) echo "AIRSPOT_HARDWARE must be rev3a or legacy" >&2; return 1 ;;
esac

# NCS Toolchain Configuration
NCS_TOOLCHAIN_DIR="/opt/nordic/ncs/toolchains/322ac893fe"
export ZEPHYR_TOOLCHAIN_VARIANT=zephyr
export ZEPHYR_SDK_INSTALL_DIR="$NCS_TOOLCHAIN_DIR/opt/zephyr-sdk"
export ZEPHYR_BASE="$AIRSPOT_WORKSPACE/external/zephyr"

# Source Zephyr environment (provides west build command)
if [ -f "$ZEPHYR_BASE/zephyr-env.sh" ]; then
    source "$ZEPHYR_BASE/zephyr-env.sh" 2>/dev/null
fi

# Add NCS toolchain to PATH but keep system git (NCS git is broken on macOS)
# System git must come BEFORE NCS toolchain paths
NCS_PATH="$NCS_TOOLCHAIN_DIR/Cellar/cmake/3.21.0/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/usr/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/usr/local/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/opt/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/opt/nanopb/generator-bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/nrfutil/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/opt/zephyr-sdk/arm-zephyr-eabi/bin"
NCS_PATH="$NCS_PATH:$NCS_TOOLCHAIN_DIR/opt/zephyr-sdk/riscv64-zephyr-elf/bin"

if [[ ":$PATH:" != *":$NCS_TOOLCHAIN_DIR/Cellar/cmake:"* ]]; then
    # Put system paths first so system git is used (NCS git missing remote-https)
    export PATH="/usr/bin:/opt/homebrew/bin:$NCS_PATH:$PATH"
fi

# Colors
_RED='\033[0;31m'
_GREEN='\033[0;32m'
_YELLOW='\033[1;33m'
_BLUE='\033[0;34m'
_CYAN='\033[0;36m'
_NC='\033[0m'

_print_success() { echo -e "${_GREEN}✓${_NC} $1"; }
_print_error() { echo -e "${_RED}✗${_NC} $1"; }
_print_info() { echo -e "${_BLUE}ℹ${_NC} $1"; }
_print_warning() { echo -e "${_YELLOW}⚠${_NC} $1"; }

# Extract version from version.h
_get_firmware_version() {
    local version_file="$AIRSPOT_PROJECT_DIR/include/airspot/version.h"
    if [ -f "$version_file" ]; then
        local major minor patch
        major=$(grep 'AIRSPOT_FIRMWARE_VERSION_MAJOR' "$version_file" | grep -o '[0-9]*')
        minor=$(grep 'AIRSPOT_FIRMWARE_VERSION_MINOR' "$version_file" | grep -o '[0-9]*')
        patch=$(grep 'AIRSPOT_FIRMWARE_VERSION_PATCH' "$version_file" | grep -o '[0-9]*')
        echo "${major}.${minor}.${patch}"
    else
        echo "0.0.0"
    fi
}

# Get kernel bin name based on version
_get_bin_name() {
    local version="$(_get_firmware_version)"
    if [ "$AIRSPOT_HARDWARE" = rev3a ]; then
        echo "airspot_slim_rev3a_v${version}"
    else
        echo "airspot_slim_v${version}"
    fi
}

_find_jlinkexe() {
    if command -v JLinkExe &> /dev/null; then
        command -v JLinkExe
        return 0
    fi
    local jlink
    jlink=$(ls -1 /Applications/SEGGER/JLink_*/JLinkExe 2>/dev/null | sort | tail -n 1)
    if [ -n "$jlink" ]; then
        echo "$jlink"
        return 0
    fi
    return 1
}

# Main airspot command function
airspot() {
    local cmd=$1
    [[ $# -gt 0 ]] && shift
    
    case "$cmd" in
        build)
            airspot_build "$@"
            ;;
        check)
            bash "$AIRSPOT_WORKSPACE/scripts/airspot-rev3a" check "$@"
            ;;
        flash)
            airspot_flash "$@"
            ;;
        ports)
            airspot_ports
            ;;
        logs)
            airspot_logs "$@"
            ;;
        monitor)
            airspot_logs "$@"
            ;;
        erase)
            airspot_erase "$@"
            ;;
        reset)
            airspot_reset "$@"
            ;;
        clean)
            airspot_clean "$@"
            ;;
        info)
            airspot_info "$@"
            ;;
        memory)
            airspot_memory "$@"
            ;;
        version)
            airspot_version
            ;;
        menu)
            airspot_menu
            ;;
        bf)
            airspot_build "$@" && airspot_flash "$@"
            ;;
        bfl)
            airspot_build "$@" && airspot_flash "$@" && airspot_logs
            ;;
        help|--help|-h)
            airspot_help
            ;;
        *)
            if [ -z "$cmd" ]; then
                airspot_help
            else
                _print_error "Unknown command: $cmd"
                airspot_help
                return 1
            fi
            ;;
    esac
}

# Update prj.conf with current version
_update_prj_conf_version() {
    local version="$(_get_firmware_version)"
    local prj_conf="$AIRSPOT_PROJECT_DIR/prj.conf"
    local bin_name="airspot_slim_v${version}"
    
    # Check if CONFIG_KERNEL_BIN_NAME exists and update it
    if grep -q "CONFIG_KERNEL_BIN_NAME" "$prj_conf"; then
        # Update existing line
        sed -i.bak "s/CONFIG_KERNEL_BIN_NAME=.*/CONFIG_KERNEL_BIN_NAME=\"${bin_name}\"/" "$prj_conf"
        rm -f "${prj_conf}.bak"
    fi
}

# True if Intel HEX programs the MCUboot primary slot (app @ 0xC000+).
_airspot_hex_is_merged_layout() {
    local hex_file="$1"
    python3 - "$hex_file" <<'PY'
import sys
path = sys.argv[1]
ext = 0
for line in open(path):
    line = line.strip()
    if not line.startswith(":"):
        continue
    count = int(line[1:3], 16)
    addr = int(line[3:7], 16)
    typ = int(line[7:9], 16)
    if typ == 4:
        ext = int(line[9:9 + 4], 16) << 16
    elif typ == 0:
        if ext + addr + count > 0xC000:
            sys.exit(0)
sys.exit(1)
PY
}

_airspot_find_merged_hex() {
    if [ -f "$AIRSPOT_BUILD_DIR/merged.hex" ]; then
        echo "$AIRSPOT_BUILD_DIR/merged.hex"
    elif [ -f "$AIRSPOT_BUILD_DIR/zephyr/merged.hex" ]; then
        echo "$AIRSPOT_BUILD_DIR/zephyr/merged.hex"
    fi
}

_airspot_locate_signed_bin() {
    local sysbuild_dir="$1"
    local bin_base_name="$2"
    if [ -f "$sysbuild_dir/application/zephyr/${bin_base_name}.signed.bin" ]; then
        echo "$sysbuild_dir/application/zephyr/${bin_base_name}.signed.bin"
    elif [ -f "$sysbuild_dir/application/zephyr/zephyr.signed.bin" ]; then
        echo "$sysbuild_dir/application/zephyr/zephyr.signed.bin"
    elif [ -f "$sysbuild_dir/app/zephyr/zephyr.signed.bin" ]; then
        echo "$sysbuild_dir/app/zephyr/zephyr.signed.bin"
    elif [ -f "$sysbuild_dir/zephyr/zephyr.signed.bin" ]; then
        echo "$sysbuild_dir/zephyr/zephyr.signed.bin"
    fi
}

# Build command (default: sysbuild + merged.hex for J-Link)
airspot_build() {
    if [ "$AIRSPOT_HARDWARE" = rev3a ]; then
        bash "$AIRSPOT_WORKSPACE/scripts/airspot-rev3a" build "$@"
        return $?
    fi
    local version="$(_get_firmware_version)"
    local bin_base_name="airspot_slim_v${version}"
    local timestamp=$(date +"%Y%m%d_%H%M%S")
    local do_dfu_zip=false
    local do_bootloader=false
    local do_clean=false
    local pristine=""
    
    _print_info "AirSpot Slim Firmware v${version}"
    cd "$AIRSPOT_PROJECT_DIR"
    
    # Ensure system git is used
    export PATH="/usr/bin:/opt/homebrew/bin:$PATH"
    
    # Update prj.conf with current version
    _update_prj_conf_version
    
    # Parse arguments
    for arg in "$@"; do
        case "$arg" in
            --clean|--pristine)
                do_clean=true
                pristine="--pristine"
                ;;
            --dfu)
                do_dfu_zip=true
                ;;
            --bootloader|--mcuboot|--dfu-boot)
                do_bootloader=true
                ;;
            --legacy|--no-sysbuild)
                _print_warning "--legacy is the default now; use --bootloader for MCUboot merged.hex"
                ;;
        esac
    done

    if [ "$do_clean" = true ]; then
        _print_info "Removing existing build directory for a true clean build..."
        rm -rf "$AIRSPOT_BUILD_DIR"
    fi

    if [ "$do_bootloader" = true ]; then
        _print_info "Building with MCUboot (sysbuild → merged.hex for OTA layout)..."
        rm -f "$AIRSPOT_BUILD_DIR/.airspot_flash_mono"
        "${AIRSPOT_PROJECT_DIR}/scripts/ensure_mcuboot_key_link.sh"
        west build -b "$AIRSPOT_BOARD" --sysbuild $pristine
        if [ $? -ne 0 ]; then
            _print_error "Sysbuild failed!"
            return 1
        fi

        local merged_hex
        merged_hex="$(_airspot_find_merged_hex)"
        if [ -z "$merged_hex" ] || ! _airspot_hex_is_merged_layout "$merged_hex"; then
            _print_error "merged.hex missing or invalid (expected app data at 0xC000+)."
            return 1
        fi

        _print_success "Build complete: $merged_hex"
        airspot_memory

        local release_version_dir="$AIRSPOT_WORKSPACE/releases/v${version}"
        mkdir -p "$release_version_dir"
        local merged_hex_name="${bin_base_name}_${timestamp}_merged.hex"
        cp "$merged_hex" "$release_version_dir/$merged_hex_name"
        cp "$merged_hex" "$AIRSPOT_BUILD_DIR/merged.hex"
        _print_success "Release: releases/v${version}/$merged_hex_name"

        if [ "$do_dfu_zip" = true ]; then
            local sysbuild_dir="$AIRSPOT_BUILD_DIR"
            local app_update_bin
            app_update_bin="$(_airspot_locate_signed_bin "$sysbuild_dir" "$bin_base_name")"
            if [ -z "$app_update_bin" ]; then
                _print_error "Could not find signed binary for DFU zip."
                return 1
            fi

            _print_info "Packaging DFU zip (OTA still disabled in app — archive only)..."
            local dfu_zip_name="${bin_base_name}_${timestamp}_dfu.zip"
            local dfu_zip_path="$release_version_dir/$dfu_zip_name"
            local sysbuild_dfu_zip="$sysbuild_dir/dfu_application.zip"
            if [ -f "$sysbuild_dfu_zip" ]; then
                cp "$sysbuild_dfu_zip" "$dfu_zip_path"
            else
                local tmp_manifest="$release_version_dir/.manifest_tmp.json"
                cat > "$tmp_manifest" << EOF
{
    "format-version": 1,
    "time": $(date +%s),
    "files": [
        {
            "type": "application",
            "board": "airspot_slim",
            "soc": "nrf54l05",
            "version": "$version",
            "file": "application.signed.bin"
        }
    ]
}
EOF
                cp "$app_update_bin" "$release_version_dir/application.signed.bin"
                mv "$tmp_manifest" "$release_version_dir/manifest.json"
                (cd "$release_version_dir" && zip -j "$dfu_zip_path" manifest.json application.signed.bin)
                rm -f "$release_version_dir/manifest.json" "$release_version_dir/application.signed.bin"
            fi
            cp "$app_update_bin" "$release_version_dir/${bin_base_name}_${timestamp}_signed.bin"
            _print_success "DFU archive: releases/v${version}/$dfu_zip_name"
        fi
        return 0
    fi

    _print_info "Building monolithic app @ 0x0 (UART bring-up — same style as AH01)..."
    mkdir -p "$AIRSPOT_BUILD_DIR"
    touch "$AIRSPOT_BUILD_DIR/.airspot_flash_mono"
    rm -f "$AIRSPOT_BUILD_DIR/merged.hex" "$AIRSPOT_BUILD_DIR/zephyr/merged.hex"
    west build -b "$AIRSPOT_BOARD" --no-sysbuild $pristine -- \
        -DPM_STATIC_YML_FILE="$AIRSPOT_PROJECT_DIR/pm_static_mono.yml"
    if [ $? -ne 0 ]; then
        _print_error "Build failed!"
        return 1
    fi

    local app_bin="$AIRSPOT_BUILD_DIR/zephyr/${bin_base_name}.bin"
    if [ ! -f "$app_bin" ]; then
        app_bin="$AIRSPOT_BUILD_DIR/zephyr/zephyr.bin"
    fi
    if [ ! -f "$app_bin" ]; then
        _print_error "Application .bin not found under build/zephyr/"
        return 1
    fi

    _print_success "Build complete: $app_bin (flash this — mono .hex is 64 KB only)"
    airspot_memory

    local release_version_dir="$AIRSPOT_WORKSPACE/releases/v${version}"
    mkdir -p "$release_version_dir"
    local bin_name="${bin_base_name}_${timestamp}.bin"
    cp "$app_bin" "$release_version_dir/$bin_name"
    _print_success "Release: releases/v${version}/$bin_name"
    _print_warning "Do not J-Link flash zephyr/*.hex for mono builds — use .bin or airspot flash"
}

_airspot_find_mono_hex() {
    local bin_name="$(_get_bin_name)"
    if [ -f "$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.hex" ]; then
        echo "$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.hex"
    elif [ -f "$AIRSPOT_BUILD_DIR/zephyr/zephyr.hex" ]; then
        echo "$AIRSPOT_BUILD_DIR/zephyr/zephyr.hex"
    fi
}

_airspot_find_mono_bin() {
    local bin_name="$(_get_bin_name)"
    if [ -f "$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.bin" ]; then
        echo "$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.bin"
    elif [ -f "$AIRSPOT_BUILD_DIR/zephyr/zephyr.bin" ]; then
        echo "$AIRSPOT_BUILD_DIR/zephyr/zephyr.bin"
    fi
}

_airspot_find_flash_hex() {
    if [ -f "$AIRSPOT_BUILD_DIR/.airspot_flash_mono" ]; then
        _airspot_find_mono_hex
    else
        _airspot_find_merged_hex
    fi
}

# Highest byte address covered by Intel HEX data records (0 if unreadable).
_airspot_hex_image_end() {
    local hex_file="$1"
    python3 - "$hex_file" <<'PY'
import sys
path = sys.argv[1]
ext = 0
end = 0
try:
    f = open(path)
except OSError:
    sys.exit(0)
for line in f:
    line = line.strip()
    if not line.startswith(":"):
        continue
    count = int(line[1:3], 16)
    addr = int(line[3:7], 16)
    typ = int(line[7:9], 16)
    if typ == 4:
        ext = int(line[9:9 + 4], 16) << 16
    elif typ == 0:
        end = max(end, ext + addr + count)
print(end)
PY
}

# Zephyr mono .hex often omits extended linear records — only the first 64 KB is programmed.
_airspot_hex_undersized_vs_bin() {
    local hex_file="$1"
    local bin_file="$2"
    [ -f "$hex_file" ] && [ -f "$bin_file" ] || return 1
    local hex_end bin_sz
    hex_end="$(_airspot_hex_image_end "$hex_file")"
    bin_sz=$(wc -c < "$bin_file" | tr -d ' ')
    [ "$bin_sz" -gt 65536 ] && [ "$hex_end" -le 65536 ]
}

# Pick .bin for truncated mono hex; merged.hex and full mono hex (e.g. AH01) stay .hex.
_airspot_pick_flash_image() {
    local image="${1:-}"

    if [ -z "$image" ]; then
        image="$(_airspot_find_merged_hex)"
    fi
    if [ -z "$image" ] || { [ -f "$AIRSPOT_BUILD_DIR/.airspot_flash_mono" ] && ! _airspot_hex_is_merged_layout "$image" 2>/dev/null; }; then
        local mono_bin mono_hex
        mono_bin="$(_airspot_find_mono_bin)"
        mono_hex="$(_airspot_find_mono_hex)"
        if [ -n "$mono_bin" ]; then
            image="$mono_bin"
        elif [ -n "$mono_hex" ]; then
            image="$mono_hex"
        fi
    fi

    if [ -z "$image" ] || [ ! -f "$image" ]; then
        return 1
    fi

    case "$image" in
        *.bin)
            echo "$image"
            return 0
            ;;
        *.hex)
            if _airspot_hex_is_merged_layout "$image"; then
                echo "$image"
                return 0
            fi
            local paired_bin="${image%.hex}.bin"
            if [ ! -f "$paired_bin" ]; then
                paired_bin="$(_airspot_find_mono_bin)"
            fi
            if [ -n "$paired_bin" ] && _airspot_hex_undersized_vs_bin "$image" "$paired_bin"; then
                _print_warning "Mono .hex only covers 64 KB — flashing .bin instead (required after chiperase)."
                echo "$paired_bin"
                return 0
            fi
            echo "$image"
            return 0
            ;;
        *)
            echo "$image"
            return 0
            ;;
    esac
}

_airspot_nrfjprog_program() {
    local image="$1"
    nrfjprog --recover -f NRF54L
    if [[ "$image" == *.bin ]]; then
        nrfjprog --program "$image" --chiperase --verify -f NRF54L
    else
        nrfjprog --program "$image" --chiperase --verify -f NRF54L
    fi
    nrfjprog --reset -f NRF54L
}

_airspot_jlink_program() {
    local image="$1"
    local jlinkexe="$2"
    local load_cmd
    if [[ "$image" == *.bin ]]; then
        load_cmd="loadbin $image, 0x0"
    else
        load_cmd="loadfile $image"
    fi
    cat > /tmp/jlink_flash.jlink <<EOF
device NRF54L05_XXAA
si SWD
speed 4000
r
$load_cmd
r
q
EOF
    "$jlinkexe" -CommandFile /tmp/jlink_flash.jlink
    rm -f /tmp/jlink_flash.jlink
}

# Flash — full chip erase; mono uses .bin @ 0x0; merged.hex for MCUboot builds
airspot_flash() {
    if [ "$AIRSPOT_HARDWARE" = rev3a ]; then
        bash "$AIRSPOT_WORKSPACE/scripts/airspot-rev3a" flash "$@"
        return $?
    fi
    local image_arg="${1:-}"
    local force_any=false

    if [ "$image_arg" = "--force" ] || [ "$image_arg" = "--force-legacy" ]; then
        force_any=true
        image_arg="${2:-}"
    fi

    local image
    image="$(_airspot_pick_flash_image "$image_arg")" || true
    if [ -z "$image" ] || [ ! -f "$image" ]; then
        _print_error "No firmware image found. Run: airspot build --clean"
        return 1
    fi

    if _airspot_hex_is_merged_layout "$image" 2>/dev/null; then
        _print_info "Image type: MCUboot merged (bootloader + app @ 0xC000)"
    elif [[ "$image" == *.bin ]]; then
        _print_info "Image type: monolithic .bin @ 0x0 ($(wc -c < "$image" | tr -d ' ') bytes)"
    else
        _print_info "Image type: monolithic hex @ 0x0"
        if [ "$force_any" != true ] && _airspot_hex_is_merged_layout "$AIRSPOT_BUILD_DIR/merged.hex" 2>/dev/null; then
            _print_warning "merged.hex exists in build/ but you are flashing a mono image."
        fi
    fi

    cd "$AIRSPOT_PROJECT_DIR"
    _print_info "Recover + program (full erase): $image"

    if command -v nrfjprog &> /dev/null; then
        _airspot_nrfjprog_program "$image"
    else
        local jlinkexe
        jlinkexe="$(_find_jlinkexe)"
        if [ -n "$jlinkexe" ]; then
            _print_warning "nrfjprog not found. Falling back to JLinkExe."
            _airspot_jlink_program "$image" "$jlinkexe"
        else
            _print_error "No flash tool found (nrfjprog or JLinkExe)."
            _print_info "Install Nordic nRF Command Line Tools or SEGGER J-Link."
            return 1
        fi
    fi

    if [ $? -eq 0 ]; then
        _print_success "Flash complete!"
        sleep 0.5
    else
        _print_error "Flash failed!"
        return 1
    fi
}

_airspot_list_uart_ports() {
    ls /dev/cu.usbmodem* /dev/cu.usbserial* /dev/tty.usbmodem* /dev/tty.usbserial* 2>/dev/null
}

# Prefer cu.* on macOS (non-blocking open; works better with multiple clients)
_airspot_normalize_uart_port() {
    local port="$1"
    if [[ "$port" == /dev/tty.* ]]; then
        local cu_port="/dev/cu.${port#/dev/tty.}"
        if [ -e "$cu_port" ]; then
            echo "$cu_port"
            return
        fi
    fi
    echo "$port"
}

_airspot_uart_port_holder() {
    local port="$1"
    lsof 2>/dev/null | awk -v p="$port" '$9 == p { print $1, $2; exit }'
}

airspot_ports() {
    echo ""
    _print_info "Detected UART ports"
    echo "══════════════════════════════════════"
    local ports
    ports="$(_airspot_list_uart_ports)"
    if [ -z "$ports" ]; then
        _print_warning "No UART ports found."
        return 1
    fi
    while IFS= read -r port; do
        local holder
        holder="$(_airspot_uart_port_holder "$port")"
        if [ -n "$holder" ]; then
            echo "$port  (in use: $holder)"
        else
            echo "$port"
        fi
    done <<< "$ports"
    echo ""
    _print_info "Only one app can open a serial port (screen, nRF Connect Serial, etc.)."
}

_airspot_logs_uart() {
    local port="${1}"
    local baud="${2:-115200}"

    if [ -z "$port" ]; then
        local ports
        ports="$(_airspot_list_uart_ports)"
        if [ -z "$ports" ]; then
            port=""
        else
            local count
            count=$(echo "$ports" | wc -l | tr -d ' ')
            if [ "$count" -eq 1 ]; then
                port="$ports"
            else
                _print_info "Multiple UART ports detected:"
                local i=1
                while IFS= read -r line; do
                    echo "  $i) $line"
                    i=$((i + 1))
                done <<< "$ports"
                echo -n "Select port [1-$((i - 1))] (default 1): "
                read selection
                if [ -z "$selection" ]; then
                    selection=1
                fi
                port=$(echo "$ports" | sed -n "${selection}p")
            fi
        fi
    fi

    if [ -z "$port" ]; then
        _print_error "No UART device found. Pass port explicitly."
        airspot_ports
        _print_info "Example: airspot logs uart /dev/cu.usbserial-XXXX 115200"
        return 1
    fi

    port="$(_airspot_normalize_uart_port "$port")"
    local holder
    holder="$(_airspot_uart_port_holder "$port")"
    if [ -n "$holder" ]; then
        _print_error "Port busy: $port (held by: $holder)"
        _print_info "Close the other terminal (Ctrl+A then K in screen), or run:"
        _print_info "  kill ${holder#* }"
        _print_info "Then reconnect nRF Connect Serial or: airspot logs uart $port"
        return 1
    fi

    _print_info "UART monitor — Slim debug TX on P1.02 @ ${baud} baud"
    _print_info "Port: $port"
    _print_warning "Use a USB-serial adapter on the Slim debug header, not the nRF DK USB port"
    _print_warning "Press Ctrl+C to exit"
    echo ""

    if command -v screen &> /dev/null; then
        screen "$port" "$baud"
    elif command -v picocom &> /dev/null; then
        picocom -b "$baud" "$port"
    elif command -v minicom &> /dev/null; then
        minicom -b "$baud" -D "$port"
    else
        _print_error "No serial monitor found (screen/picocom/minicom)."
        return 1
    fi
}

_airspot_logs_rtt() {
    if [ "$AIRSPOT_HARDWARE" = rev3a ]; then
        bash "$AIRSPOT_WORKSPACE/scripts/airspot-rev3a" rtt "$@"
        return $?
    fi
    _print_info "RTT monitor (requires firmware built with prj_rtt.conf)"
    _print_info "Device: NRF54L05_XXAA | SWD via J-Link (same cable as flash)"
    _print_warning "Press Ctrl+C to exit"
    echo ""

    if command -v nrfjprog &> /dev/null; then
        _print_info "Resetting device..."
        nrfjprog --reset -f NRF54L 2>/dev/null
        sleep 0.3
    fi

    local rtt_args=(-Device "$AIRSPOT_JLINK_DEVICE" -If SWD -Speed 4000 -RTTChannel 0)

    if command -v JLinkRTTClient &> /dev/null; then
        _print_info "Starting JLinkRTTClient..."
        JLinkRTTClient "${rtt_args[@]}"
    elif command -v JLinkRTTLogger &> /dev/null; then
        local log_file="/tmp/airspot_rtt.log"
        _print_info "Logging to $log_file (tail -f in another terminal)"
        JLinkRTTLogger "${rtt_args[@]}" -OutputFile "$log_file" &
        local pid=$!
        trap "kill $pid 2>/dev/null" EXIT
        tail -f "$log_file"
    elif command -v JLinkExe &> /dev/null; then
        _print_info "Starting JLinkExe RTT viewer..."
        JLinkExe -device "$AIRSPOT_JLINK_DEVICE" -if SWD -speed 4000 -RTTClient
    else
        _print_error "J-Link RTT tools not found (JLinkRTTClient / JLinkExe)."
        _print_info "Install SEGGER J-Link: https://www.segger.com/downloads/jlink/"
        return 1
    fi
}

# Logs/Monitor command (default UART on P1.02; optional RTT)
airspot_logs() {
    local mode="${1:-uart}"
    [[ $# -gt 0 ]] && shift

    case "$mode" in
        uart)
            _airspot_logs_uart "$@"
            ;;
        rtt)
            _airspot_logs_rtt "$@"
            ;;
        *)
            _print_error "Unknown logs mode: $mode (use: uart|rtt)"
            return 1
            ;;
    esac
}

# Erase command
airspot_erase() {
    local confirm="${1}"
    
    if [ "$confirm" != "-y" ] && [ "$confirm" != "--yes" ]; then
        _print_warning "This will erase the entire chip!"
        echo -n "Are you sure? (y/n): "
        read REPLY
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            _print_info "Erase cancelled."
            return 0
        fi
    fi
    
    _print_info "Erasing chip..."
    nrfjprog --eraseall -f NRF54L
    
    if [ $? -eq 0 ]; then
        _print_success "Chip erased!"
    else
        _print_error "Erase failed!"
        return 1
    fi
}

# Reset command
airspot_reset() {
    _print_info "Resetting device..."
    nrfjprog --reset -f NRF54L
    _print_success "Device reset!"
}

# Clean command
airspot_clean() {
    if [ "$AIRSPOT_HARDWARE" = rev3a ]; then
        bash "$AIRSPOT_WORKSPACE/scripts/airspot-rev3a" clean "$@"
        return $?
    fi
    _print_info "Cleaning build directories..."
    cd "$AIRSPOT_PROJECT_DIR"
    rm -rf build build_*
    _print_success "Build directories cleaned!"
}

# Info command
airspot_info() {
    local version="$(_get_firmware_version)"
    local bin_name="$(_get_bin_name)"
    
    echo ""
    _print_info "Device Information"
    echo "══════════════════════════════════════"
    echo ""
    echo "Firmware: AirSpot Slim v${version}"
    echo "Board:    $AIRSPOT_BOARD"
    echo ""
    echo "Connected devices:"
    nrfjprog --ids 2>/dev/null || echo "  (nrfjprog not available)"
    echo ""
    
    local elf_file=""
    if [ -f "$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.elf" ]; then
        elf_file="$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.elf"
    elif [ -f "$AIRSPOT_BUILD_DIR/application/zephyr/zephyr.elf" ]; then
        elf_file="$AIRSPOT_BUILD_DIR/application/zephyr/zephyr.elf"
    elif [ -f "$AIRSPOT_BUILD_DIR/zephyr/zephyr.elf" ]; then
        elf_file="$AIRSPOT_BUILD_DIR/zephyr/zephyr.elf"
    fi
    
    if [ -n "$elf_file" ]; then
        airspot_memory
    fi
}

# Memory command
airspot_memory() {
    if [ "$AIRSPOT_HARDWARE" = rev3a ]; then
        bash "$AIRSPOT_WORKSPACE/scripts/airspot-rev3a" memory "$@"
        return $?
    fi
    local bin_name="$(_get_bin_name)"
    local elf_file=""
    
    if [ -f "$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.elf" ]; then
        elf_file="$AIRSPOT_BUILD_DIR/zephyr/${bin_name}.elf"
    elif [ -f "$AIRSPOT_BUILD_DIR/application/zephyr/zephyr.elf" ]; then
        elf_file="$AIRSPOT_BUILD_DIR/application/zephyr/zephyr.elf"
    elif [ -f "$AIRSPOT_BUILD_DIR/zephyr/zephyr.elf" ]; then
        elf_file="$AIRSPOT_BUILD_DIR/zephyr/zephyr.elf"
    fi
    
    if [ -z "$elf_file" ]; then
        _print_error "No build found."
        return 1
    fi
    
    echo ""
    _print_info "Memory Usage"
    echo "══════════════════════════════════════"
    "$ZEPHYR_SDK_INSTALL_DIR/arm-zephyr-eabi/bin/arm-zephyr-eabi-size" "$elf_file"
    echo ""
}

# Version command
airspot_version() {
    local version="$(_get_firmware_version)"
    echo ""
    _print_info "AirSpot Slim Firmware"
    echo "══════════════════════════════════════"
    echo "Version: v${version}"
    echo "Build name: $(_get_bin_name)"
    echo ""
    
    # Show latest release if exists
    local releases_dir="$AIRSPOT_WORKSPACE/releases"
    if [ -d "$releases_dir" ]; then
        local latest=$(ls -1t "$releases_dir"/*.hex 2>/dev/null | head -1)
        if [ -n "$latest" ]; then
            echo "Latest release: $(basename "$latest")"
        fi
    fi
    echo ""
}

# Interactive menu
airspot_menu() {
    while true; do
        echo ""
        echo -e "${_CYAN}╔══════════════════════════════════════════════════╗${_NC}"
        echo -e "${_CYAN}║${_NC}  ${_GREEN}AirSpot Slim Development Tool${_NC}                  ${_CYAN}║${_NC}"
        echo -e "${_CYAN}╚══════════════════════════════════════════════════╝${_NC}"
        echo ""
        echo -e "${_GREEN}BUILD & FLASH:${_NC}"
        echo "  1) Build"
        echo "  2) Flash"
        echo "  3) Build + Flash"
        echo "  4) Build + Flash + Logs"
        echo ""
        echo -e "${_GREEN}MONITORING:${_NC}"
        echo "  5) Logs/Monitor (UART default)"
        echo ""
        echo -e "${_GREEN}DEVICE:${_NC}"
        echo "  6) Reset"
        echo "  7) Erase chip"
        echo "  8) Device info"
        echo "  9) Clean build"
        echo ""
        echo -e "${_RED} 0) Exit${_NC}"
        echo ""
        echo -n "Select option: "
        read choice
        
        case $choice in
            1) airspot build ;;
            2) airspot flash ;;
            3) airspot bf ;;
            4) airspot bfl ;;
            5) airspot logs ;;
            6) airspot reset ;;
            7) airspot erase ;;
            8) airspot info ;;
            9) airspot clean ;;
            0) break ;;
            *) _print_error "Invalid option" ;;
        esac
        
        if [ "$choice" != "0" ]; then
            echo ""
            echo -n "Press Enter to continue..."
            read
        fi
    done
}

# Help command
airspot_help() {
    if [ "$AIRSPOT_HARDWARE" = rev3a ]; then
        bash "$AIRSPOT_WORKSPACE/scripts/airspot-rev3a" help
        echo "UART logs: airspot logs uart; device information: airspot info"
        echo "Legacy hardware: export AIRSPOT_HARDWARE=legacy; source scripts/airspot"
        return 0
    fi
    local version="$(_get_firmware_version)"
    cat << EOF

AirSpot Slim Development Tool (v${version})
═════════════════════════════════════════════════════════

COMMANDS:
  airspot build [opts]      - Mono app @ 0x0 (default); --bootloader for merged.hex
    Options:
      --clean               - Clean build
      --dfu                 - DFU zip (with --bootloader only)
      --bootloader          - MCUboot sysbuild → merged.hex
  
  airspot flash [image]     - Recover + chiperase; mono uses .bin, MCUboot uses merged.hex
  airspot logs [uart|rtt]   - View logs (UART default on P1.02 @ 115200)
  airspot monitor           - Alias for logs
  airspot erase [-y]        - Erase entire chip
  airspot reset             - Reset device
  airspot clean             - Clean build directory
  airspot info              - Show device information
  airspot memory            - Show memory usage
  airspot version           - Show firmware version
  airspot menu              - Interactive menu
  airspot help              - Show this help

SHORTCUTS:
  airspot bf                - Build + Flash
  airspot bfl               - Build + Flash + Logs

RELEASE ARTIFACTS:
  Releases are organized by version in: releases/v${version}/
  
  J-Link flash (required):
    - airspot_slim_v${version}_TIMESTAMP_merged.hex

  Optional (--dfu):
    - airspot_slim_v${version}_TIMESTAMP_dfu.zip
    - airspot_slim_v${version}_TIMESTAMP_signed.bin

EXAMPLES:
  airspot build --clean     # merged.hex for J-Link
  airspot flash             # recover + chiperase + merged.hex
  application/scripts/flash_recovery.sh   # same, latest release merged.hex
  airspot logs              # View UART logs
  airspot bfl               # Build, flash, and view logs

EOF
}

# Only show menu if script is executed directly (not sourced)
if [[ -z "${AIRSPOT_NO_AUTO_MENU}" && -t 0 ]]; then
    if [[ -n "${ZSH_VERSION}" ]]; then
        if [[ "$ZSH_EVAL_CONTEXT" = toplevel ]]; then
            airspot_menu
        fi
    elif [[ -n "${BASH_VERSION}" ]]; then
        if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
            airspot_menu
        fi
    fi
fi
